---
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { light }]}>
  <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
    <rect width="40" height="40" rx="11" fill={light ? '#ffffff' : '#0d6b63'} />
    <path d="M20 7.5s7.5 8 7.5 13.2a7.5 7.5 0 0 1-15 0C12.5 15.5 20 7.5 20 7.5Z" fill={light ? '#0d6b63' : '#ffffff'} />
    <path d="M9 30.5c2.2 0 2.2-1.6 4.4-1.6s2.2 1.6 4.4 1.6 2.2-1.6 4.4-1.6 2.2 1.6 4.4 1.6 2.2-1.6 4.4-1.6" fill="none" stroke="#f4a93b" stroke-width="2.4" stroke-linecap="round" />
  </svg>
  <span class="words"><b>Harbourline</b><small>Plumbing &amp; Heating</small></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 11px; color: var(--ink); }
  .words { display: grid; line-height: 1.05; }
  b { font-family: var(--display); font-size: 21px; letter-spacing: -0.02em; }
  small { font-size: 12.5px; font-weight: 600; color: var(--muted); letter-spacing: .02em; }
  .light { color: #fff; }
  .light small { color: rgba(255,255,255,.7); }
</style>
